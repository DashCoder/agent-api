# --- Hermes Agent ---------------------------------------------------------
# mock = built-in fake agent (no Hermes needed). hermes = real Hermes API server.
HERMES_MODE=mock
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=same-value-as-API_SERVER_KEY-in-~/.hermes/.env
HERMES_MODEL=hermes-agent
# Admin-only link to the full Hermes dashboard (e.g. a Tailscale Serve URL). Leave empty to hide.
HERMES_DASHBOARD_URL=

# --- App ------------------------------------------------------------------
SECRET_KEY=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"
COOKIE_SECURE=false          # true when served over HTTPS
CORS_ORIGINS=http://localhost:5173
DATA_DIR=./data

# --- Admin login ------------------------------------------------------------
ADMIN_USERNAME=admin
# Generate with: python -m app.cli hash-password
ADMIN_PASSWORD_HASH=
# Dev only (ignored when ADMIN_PASSWORD_HASH is set):
ADMIN_PASSWORD=admin

# --- Dev helpers -------------------------------------------------------------
DEV_SHOW_CODES=true          # return "Save my work" codes in the API response (turn off in production)
