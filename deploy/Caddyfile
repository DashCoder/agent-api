# Serves the built agent-ui and proxies /api to agent-api — one origin, so cookies just work.
# Listens on localhost only; publish it with Tailscale Serve/Funnel or Cloudflare Tunnel.
{
	admin off
}

http://127.0.0.1:8080, http://*.localhost:8080, http://127.0.0.1:8088, http://*.localhost:8088 {
	bind 127.0.0.1 [::1]   # this Mac only: 8080 for browsers on the mini, 8088 the same port as the SSH tunnel
	encode zstd gzip

	# live previews from the coding agent, each on its own address: http://<project>-<ticket>.localhost:8088
	# (browsers send *.localhost to your own computer, so the SSH tunnel carries it). agent-api serves them.
	@preview host *.localhost
	handle @preview {
		rewrite * /__preview/{http.request.host.labels.1}{uri}
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1   # stream SSE replies immediately
		}
	}

	handle {
		root * /Users/aiagents/apps/agent-ui/dist
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
}
