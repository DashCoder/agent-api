<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hermes web dashboard on 127.0.0.1:9119 (no login - admin access via Tailscale only). -->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/aiagents</string>
		<key>PATH</key>
		<string>/Users/aiagents/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>ai.agents.hermes-dashboard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/aiagents/.local/bin/hermes</string>
		<string>dashboard</string>
		<string>--no-open</string>
		<string>--port</string>
		<string>9119</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/aiagents/Library/Logs/hermes-dashboard.log</string>
	<key>StandardOutPath</key>
	<string>/Users/aiagents/Library/Logs/hermes-dashboard.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>UserName</key>
	<string>aiagents</string>
	<key>WorkingDirectory</key>
	<string>/Users/aiagents</string>
</dict>
</plist>
